"""
Graph Builder - Phase 1
========================

This file builds the LangGraph for Phase 1: Entry + Router

Flow: User Input → rewrite_query → llm_decide_path
"""

from typing import Literal, TypedDict
from typing_extensions import NamedTuple
import operator
from langgraph.graph import StateGraph, END
from langgraph.graph.message import add_messages

# Import our Phase 1 nodes
from nodes.entry import rewrite_query_node
from nodes.router import llm_decide_path_node


# =============================================================================
# State Definition (Simplified for Phase 1)
# =============================================================================

class Phase1State(TypedDict):
    """State schema for Phase 1: Entry and Router"""
    user_input: str
    rewritten_query: str
    decided_path: str
    confidence_score: float


# =============================================================================
# Graph Builder
# =============================================================================

def build_phase1_graph():
    """
    Build the complete graph for Phase 1.

    Flow:
        User Input → rewrite_query → llm_decide_path → (conditional routing)
    """
    graph = StateGraph(Phase1State)

    # Add nodes
    graph.add_node("rewrite_query", rewrite_query_node)
    graph.add_node("llm_decide_path", llm_decide_path_node)

    # Define entry point
    graph.set_entry_point("rewrite_query")

    # Add edges
    graph.add_edge("rewrite_query", "llm_decide_path")

    # Define conditional routing based on confidence score
    def confidence_router(state: Phase1State) -> Literal["sql_query", "sql_retrieve", "web_search", "hybrid", END]:
        """
        Conditional edge function that routes based on confidence score.

        Rules:
        - confidence > 0.7: Direct path execution
        - confidence <= 0.7: Hybrid / Multi-step processing
        """
        confidence = state.get("confidence_score", 0.0)

        # Based on decided_path, we would normally route to the specific path
        # For Phase 1, we'll route to specific paths based on confidence
        decided_path = state.get("decided_path", "sql_retrieve")

        if decided_path == "hybrid":
            return "hybrid"
        elif decided_path == "sql_query":
            return "sql_query"
        elif decided_path == "sql_retrieve":
            return "sql_retrieve"
        elif decided_path == "web_search":
            return "web_search"
        else:
            return END

    # Add conditional edge
    graph.add_conditional_edges(
        "llm_decide_path",
        confidence_router,
        {
            "sql_query": "sql_query",
            "sql_retrieve": "sql_retrieve",
            "web_search": "web_search",
            "hybrid": "hybrid",
        }
    )

    # Compile and return
    return graph.compile()


# =============================================================================
# Example Usage
# =============================================================================

def example_usage():
    """
    Example of how to use the Phase 1 graph.
    """
    graph = build_phase1_graph()

    # Define initial state
    initial_state = {
        "user_input": "Who is the head of the CSE department?",
        "rewritten_query": "Who is the head of the CSE department?",
        "decided_path": "",
        "confidence_score": 0.0,
    }

    # Invoke the graph
    result = graph.invoke(initial_state)

    print("Phase 1 Graph Result:")
    print(f"Decided Path: {result['decided_path']}")
    print(f"Confidence Score: {result['confidence_score']}")
    print(f"Rewritten Query: {result['rewritten_query']}")


if __name__ == "__main__":
    # Test the graph builder
    example_usage()