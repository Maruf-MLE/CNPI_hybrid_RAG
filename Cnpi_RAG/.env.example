"""
Project Structure Configuration
================================

This is a TEMPLATE — copy to .env and fill with real values.
DO NOT commit your actual .env file with real secrets.
"""

# Database credentials (Neon / Supabase / local)
DB_HOST=localhost
DB_NAME=cnpi_rag_db
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_PORT=5432

# LLM API Keys
GROQ_API_KEY=your-groq-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Web search configuration
WEB_SEARCH_PROVIDER=duckduckgo

# Search configuration
BM25_MODEL=ngram
TOP_K_SEARCH=5
METRIC_THRESHOLD=0.7

# Retry configuration
MAX_RETRIES=3
RETRY_DELAY_SECONDS=3

# Development settings
DEBUG=True
LOG_LEVEL=INFO

# Vector database settings
VECTOR_DB_TYPE=faiss
VECTOR_DB_PATH=./vector_db

# Hybrid processing settings
MAX_HYBRID_DEPTH=1
PARALLEL_SUB_QUERIES=True

# Django settings
DJANGO_SETTINGS_MODULE=cnpi_api.settings
SECRET_KEY=your-secret-key-here
