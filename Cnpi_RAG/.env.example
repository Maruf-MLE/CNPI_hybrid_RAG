"""
Project Structure Configuration
================================

This file should be added to .gitignore and not committed.
"""

# Database credentials
DB_HOST=localhost
DB_NAME=cnpi_rag_db
DB_USER=postgres
DB_PASSWORD=admin8899
DB_PORT=5432

# Groq API Key
GROQ_API_KEY=your-groq-api-key-here

# Optional: Configuration for embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Optional: Web search configuration
WEB_SEARCH_PROVIDER=duckduckgo
# SERP_API_KEY=your_serp_api_key_here

# Optional: Search configuration
BM25_MODEL=ngram
TOP_K_SEARCH=5
METRIC_THRESHOLD=0.7

# Optional: Retry configuration
MAX_RETRIES=3
RETRY_DELAY_SECONDS=3

# Optional: Development settings
DEBUG=True
LOG_LEVEL=INFO

# Optional: Vector database settings
VECTOR_DB_TYPE=faiss
VECTOR_DB_PATH=./vector_db

# Optional: Hybrid processing settings
MAX_HYBRID_DEPTH=1
PARALLEL_SUB_QUERIES=True

# Django settings (if using Django integration)
DJANGO_SETTINGS_MODULE=cnpi_rag.settings
SECRET_KEY=your_secret_key_here