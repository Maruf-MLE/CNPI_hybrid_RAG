# CNPI Hybrid RAG - Production Environment Variables
# ============================================================
# Copy this to HuggingFace Spaces → Settings → Repository secrets
# DO NOT commit your actual .env values!

# === Database (Supabase) ===
DB_HOST=db.xxxxxx.supabase.co
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-password
DB_PORT=5432

# === LLM API Keys ===
GEMINI_API_KEY=your-gemini-api-key

# === Django ===
DJANGO_SECRET_KEY=generate-a-new-secret-key
DEBUG=False

# === Embeddings ===
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
TOP_K_SEARCH=5

# === RAG Config ===
MAX_RETRIES=2
MAX_HYBRID_DEPTH=2
