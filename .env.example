# Environment Variables Configuration
# ===================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control!

# ---------------------------------------------------------------------------
# Database credentials (Neon PostgreSQL)
# ---------------------------------------------------------------------------
# Full connection URL (used by db_utils when present):
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# Individual vars (used by existing scripts / db_utils fallback):
DB_HOST=your-neon-host.neon.tech
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your_password_here
DB_PORT=5432
DB_SSLMODE=require

# ---------------------------------------------------------------------------
# Django Configuration
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=your-secret-key-here-change-me
SECRET_KEY=your-secret-key-here-change-me
DEBUG=True

# ---------------------------------------------------------------------------
# LangChain Configuration
# ---------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=CNPI_rag

# ---------------------------------------------------------------------------
# ManyChat Integration (NEW)
# ---------------------------------------------------------------------------
# REQUIRED: API key for authenticating ManyChat webhook requests
# Generate a secure random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
MANYCHAT_API_KEY=your_secure_manychat_api_key_here

# Optional: RAG timeout in seconds (default: 8)
RAG_TIMEOUT_SECONDS=8

# Optional: Maximum reply characters (default: 2000)
MAX_REPLY_CHARS=2000

# Optional: Log first 5 ManyChat request bodies for debugging (default: 0)
LOG_MANYCHAT_BODY=0

# ---------------------------------------------------------------------------
# Admin Panel Configuration
# ---------------------------------------------------------------------------
ADMIN_PANEL_PASSWORD=your_admin_password_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
ADMIN_ALLOWED_EMAILS=admin@example.com,user@example.com

# ---------------------------------------------------------------------------
# Facebook Messenger Webhook (Document Saver Bot)
# ---------------------------------------------------------------------------
FB_VERIFY_TOKEN=your_fb_verify_token_here
FB_APP_SECRET=your_fb_app_secret_here
FB_PAGE_ACCESS_TOKEN=your_fb_page_access_token_here
FB_ALLOWED_PSIDS=123456789,987654321

# ---------------------------------------------------------------------------
# Answer Bot Webhook (RAG-powered Q&A Bot)
# ---------------------------------------------------------------------------
ANSWER_BOT_VERIFY_TOKEN=your_answer_bot_verify_token_here
ANSWER_BOT_APP_SECRET=your_answer_bot_app_secret_here
ANSWER_BOT_PAGE_ACCESS_TOKEN=your_answer_bot_page_access_token_here
ANSWER_BOT_ALLOWED_PSIDS=
RAG_API_URL=http://127.0.0.1:8000/api/chat/

# ---------------------------------------------------------------------------
# LLM API Keys
# ---------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# Embedding Configuration
# ---------------------------------------------------------------------------
# EMBEDDING_PROVIDER:
#   local  → load SentenceTransformer in-process (needs ~2GB RAM, model download)
#   hf_api → HuggingFace Inference API (no model download, ~0 RAM, needs HF_TOKEN)
EMBEDDING_PROVIDER=hf_api
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=2000

# Required when EMBEDDING_PROVIDER=hf_api:
# Get token at: https://huggingface.co/settings/tokens (READ access is enough)
HF_TOKEN=your_huggingface_token_here

# ---------------------------------------------------------------------------
# Web Search Configuration
# ---------------------------------------------------------------------------
WEB_SEARCH_PROVIDER=duckduckgo
# SERP_API_KEY=your_serp_api_key_here

# ---------------------------------------------------------------------------
# Search Configuration
# ---------------------------------------------------------------------------
BM25_MODEL=ngram
TOP_K_SEARCH=10
METRIC_THRESHOLD=0.90

# ---------------------------------------------------------------------------
# Retry Configuration
# ---------------------------------------------------------------------------
MAX_RETRIES=3
RETRY_DELAY_SECONDS=3

# ---------------------------------------------------------------------------
# Vector Database Settings
# ---------------------------------------------------------------------------
VECTOR_DB_TYPE=faiss
VECTOR_DB_PATH=./vector_db

# ---------------------------------------------------------------------------
# Hybrid Processing Settings
# ---------------------------------------------------------------------------
MAX_HYBRID_DEPTH=1
PARALLEL_SUB_QUERIES=True

# ---------------------------------------------------------------------------
# Heartbeat / Keep-Alive
# ---------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
HEARTBEAT_SECRET=your_heartbeat_secret_here
HEARTBEAT_TARGET_URL=http://127.0.0.1:8000/api/ping/

# ---------------------------------------------------------------------------
# Render Configuration (set automatically by Render)
# ---------------------------------------------------------------------------
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
# RENDER_PUBLIC_URL=https://your-app.onrender.com
