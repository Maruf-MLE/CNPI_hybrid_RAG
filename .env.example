# CNPI Hybrid RAG - Production Environment Variables
# ============================================================
# Copy these to Render → Environment tab
# DO NOT commit your actual .env values!

# === Database (Neon) ===
DB_HOST=ep-royal-wildflower-azq6xooz.c-3.ap-southeast-1.aws.neon.tech
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your-neon-password
DB_PORT=5432

# === LLM API Keys ===
GEMINI_API_KEY=your-gemini-api-key

# === Django ===
DJANGO_SECRET_KEY=generate-a-new-secret-key
DEBUG=False

# === Embeddings ===
# EMBEDDING_PROVIDER:
#   local  → SentenceTransformer in-process (needs ~2GB RAM + model download)
#   hf_api → HuggingFace Inference API (no model download, ~0 RAM)
# Render free tier (4GB) → use hf_api to avoid OOM crashes.
EMBEDDING_PROVIDER=hf_api
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
# Required when EMBEDDING_PROVIDER=hf_api:
# https://huggingface.co/settings/tokens  (READ access is enough)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxx
TOP_K_SEARCH=5

# === RAG Config ===
MAX_RETRIES=2
MAX_HYBRID_DEPTH=2
