# ==============================================================================
# Django Backend Environment Variables (Render.com)
# ==============================================================================
#
# এই file টি .env.render বা Render Dashboard এ Environment Variables section এ
# add করুন। কোনো actual value এখানে commit করবেন না।
#
# ==============================================================================

# ---- Django Core ----
DJANGO_SECRET_KEY=your_django_secret_key_here
DEBUG=False

# ---- Database (NeonDB PostgreSQL) ----
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your_db_password
DB_HOST=your_neon_db_host.neon.tech
DB_PORT=5432
DB_SSLMODE=require

# ---- Meta Direct Integration (NEW - Cloudflare Worker) ----
# Facebook Page Access Token
# Get from: Meta App Dashboard → Messenger → Settings → Access Tokens
META_PAGE_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret between Cloudflare Worker and Django
# Must match WORKER_SECRET set in Cloudflare Worker secrets
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_SECRET=your_shared_worker_secret_here

# ---- Fiwano Integration (LEGACY - keep for backward compatibility) ----
FIWANO_API_KEY=
FIWANO_WEBHOOK_SECRET=
FIWANO_API_BASE_URL=https://fiwano.com/api/v1

# ---- Facebook Messenger (Legacy messenger_bot app) ----
FB_VERIFY_TOKEN=
FB_APP_SECRET=
FB_PAGE_ACCESS_TOKEN=
FB_ALLOWED_PSIDS=

# ---- Answer Bot (Deprecated) ----
ANSWER_BOT_VERIFY_TOKEN=
ANSWER_BOT_APP_SECRET=
ANSWER_BOT_PAGE_ACCESS_TOKEN=
ANSWER_BOT_ALLOWED_PSIDS=

# ---- RAG System ----
# Add your LLM API keys here (Google Gemini, OpenAI, etc.)
# Check Cnpi_RAG/.env.example for the full list
GOOGLE_API_KEY=your_google_api_key

# ---- Render Config ----
RENDER_PUBLIC_URL=https://your-app.onrender.com
HEARTBEAT_SECRET=your_heartbeat_secret
HEARTBEAT_TARGET_URL=https://your-app.onrender.com/api/ping/

# ---- Google OAuth (Admin Panel) ----
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
ADMIN_ALLOWED_EMAILS=your_email@example.com
