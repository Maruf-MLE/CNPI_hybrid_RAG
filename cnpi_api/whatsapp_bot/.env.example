# WhatsApp Bot Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# WhatsApp Business API Configuration
# ============================================

# Your WhatsApp Business API token from Meta Business Manager
# Get from: https://business.facebook.com/settings/whatsapp-business-accounts
WHATSAPP_API_TOKEN=your_whatsapp_api_token_here

# Your WhatsApp Phone Number ID
# Get from: WhatsApp Business Account > Phone Numbers
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Webhook verification token (create a random secure string)
# Used during webhook setup in Meta Developer Console
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_random_verify_token_here

# Webhook secret for signature verification (optional but recommended)
# Get from: Meta Developer Console > WhatsApp > Configuration > Webhook
WHATSAPP_WEBHOOK_SECRET=your_webhook_secret_here

# WhatsApp API version (default: v18.0)
WHATSAPP_API_VERSION=v18.0

# ============================================
# RAG API Configuration
# ============================================

# Your RAG API endpoint URL
RAG_API_URL=http://127.0.0.1:8000/api/chat/

# RAG API request timeout in seconds (default: 60)
RAG_API_TIMEOUT=60

# ============================================
# Django Configuration
# ============================================

# Django secret key (generate a new one for production)
SECRET_KEY=your_django_secret_key_here

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (comma-separated, no spaces)
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# Database Configuration (if not using default SQLite)
# ============================================

# Uncomment and configure if using PostgreSQL
# DATABASE_URL=postgresql://username:password@localhost:5432/dbname

# ============================================
# Logging Configuration
# ============================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path (optional)
# LOG_FILE=/var/log/whatsapp_bot.log
